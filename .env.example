# ==============================================================================
# FlowPay (AntiGravity) Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. COPY THIS FILE TO `.env` BEFORE RUNNING THE APPLICATION.
# 2. NEVER COMMIT REAL API KEYS, PAYPAL CLIENT SECRETS, OR PRIVATE KEYS TO GIT.
# 3. DO NOT PREFIX BACKEND SECRETS WITH `VITE_` TO PREVENT CLIENT-SIDE BUNDLE LEAKS.
# ==============================================================================

# Core Application Settings
APP_NAME="FlowPay AntiGravity"
ENVIRONMENT="development"    # development | staging | production
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# JWT Authentication Security
SECRET_KEY="supersecret_flowpay_antigravity_jwt_key_change_in_production_32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
DATABASE_URL="sqlite:///./flowpay.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/flowpay_db"

# AI Engine & API Keys (DO NOT COMMIT REAL KEYS)
GEMINI_API_KEY="your_gemini_api_key_here"
AI_MATCHING_THRESHOLD=0.75

# Rate Limiting Defenses (Requests Per Minute)
RATE_LIMIT_AI_RPM=10
RATE_LIMIT_GENERAL_RPM=60

# PayPal Sandbox & Live Credentials (BACKEND ONLY)
PAYPAL_MODE="sandbox" # sandbox | live
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_for_signature_verification"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# Escrow Vault Settings
ESCROW_FEE_PERCENTAGE=2.5
PLATFORM_WALLET_ADDRESS="0xFLOWPAY_ANTIGRAVITY_ESCROW_VAULT_ADDRESS"

# ==============================================================================
# FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Web App)
# Note: ONLY variables prefixed with VITE_ are exposed to the browser JS bundle.
# NEVER place PayPal Secret or Gemini Key in VITE_ variables!
# ==============================================================================
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_public"
VITE_ENABLE_AI_RECOMMENDATIONS=true
